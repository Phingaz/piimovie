generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model movie {
  id             Int      @id @unique
  poster_path    String
  title          String
  vote_average   Int
  type           String   @default("movie")
  userId         String
  createdAt      DateTime @default(now())
  lastRatingSync DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, type])
  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@index([title])
  @@index([lastRatingSync])
  @@map("movie")
}

model filter {
  id         String   @id @default(cuid())
  title      String
  type       String
  params     String
  lastUsed   DateTime @default(now())
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String?
  User       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, isFavorite])
  @@index([userId, lastUsed])
  @@index([type])
  @@map("filter")
}

model feature_flags {
  id        String   @id @default(cuid())
  name      String   @unique
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("feature_flags")
}

model User {
  id            String          @id
  name          String
  email         String          @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  accounts      Account[]
  filter        filter[]
  movie         movie[]
  sessions      Session[]
  WebhookConfig WebhookConfig[]

  @@index([email])
  @@index([createdAt])
  @@map("user")
}

model WebhookConfig {
  id           String   @id @default(cuid())
  url          String
  headers      Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  sendAlways   Boolean  @default(false)
  isJellyseerr Boolean  @default(false)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webhook_config")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, providerId])
  @@index([userId])
  @@index([accountId])
  @@index([providerId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@index([value])
  @@index([expiresAt])
  @@map("verification")
}
